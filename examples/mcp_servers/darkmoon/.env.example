# Base URL of your self-hosted Darkmoon Dashboard API (without trailing slash).
# The Dashboard API is part of Darkmoon Pro; the open source engine and CLI do not expose it.
DARKMOON_BASE_URL="https://darkmoon.example.internal"
# Dashboard credentials used to obtain a short-lived JWT on every tool call.
DARKMOON_USERNAME="your-dashboard-user"
DARKMOON_PASSWORD="your-dashboard-password"
